++	dial := func(t *testing.T) []byte {
++		t.Helper()
++		conn, err := tls.Dial("tcp", ln.Addr().String(), &tls.Config{
++			InsecureSkipVerify: true,
++			MinVersion:         tls.VersionTLS12,
++		})

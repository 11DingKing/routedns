+func TestNextArchiveGeneration(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "query.log")
+	for _, name := range []string{"query.log.1", "query.log.2", "query.log.10", "query.log.abc", "other.9", "query.log"} {

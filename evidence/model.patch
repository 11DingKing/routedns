++	require.NoError(t, err)
++	defer ln.Close()
++	go func() {
++		for {
++			c, err := ln.Accept()
++			if err != nil {
++				return
++			}
++			go func(c net.Conn) {
++				defer c.Close()
++				_ = c.(*tls.Conn).HandshakeContext(context.Background())
++				_, _ = io.Copy(io.Discard, c)
++			}(c)
++		}
++	}()

+	var gens [][]byte
+	for i := 1; ; i++ {
+		b, err := os.ReadFile(fmt.Sprintf("%s.%d", path, i))
+		if errors.Is(err, fs.ErrNotExist) {
+			break
+		}
+		require.NoError(t, err)
+		gens = append(gens, b)
+	}
+	b, err := os.ReadFile(path)
+	if err == nil {
+		gens = append(gens, b)
+	} else {
+		require.ErrorIs(t, err, fs.ErrNotExist)
+	}
+	return gens
+}
